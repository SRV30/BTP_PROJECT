# MoodSense AI - Backend Environment Variables
# Create a .env file in this directory and fill in the values.

# Server Port
PORT=5000

# MongoDB Connection String (Atlas Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/MoodSense?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL for CORS
# For production (Vercel): https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# AI Intelligence Service URL (FastAPI)
# For production (Render): https://your-ai-service.onrender.com
AI_SERVICE_URL=http://localhost:8000

# AI Service Request Timeout (ms)
AI_SERVICE_TIMEOUT_MS=60000

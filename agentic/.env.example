# MoodSense AI - Agentic Service Environment Variables
# Create a .env file in this directory and fill in the values.

# Groq API Key for Llama 3.3 Inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Name
MODEL_NAME=llama-3.3-70b-versatile

# Optional: Port for local development
PORT=8000
